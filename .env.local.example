# =============================================================================
# Unified AI Business Suite - Environment Variables
# Copy this file to `.env.local` and fill in the real values:
#   cp .env.local.example .env.local
# NEVER commit .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# 1. SUPABASE  (Project Settings -> API)
# -----------------------------------------------------------------------------
# Read only by src/lib/supabase/admin.ts, on the server. Not a secret, but
# nothing in the browser uses it any more.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# SERVER ONLY. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NOTE: NEXT_PUBLIC_SUPABASE_ANON_KEY is deliberately NOT used. The dashboard
# used to ship it to the browser for Realtime subscriptions, which meant anyone
# could read (and delete) every chat, message and order with it. It now polls a
# Server Action that reads with the service_role key instead, and schema.sql
# enables RLS with a deny-all policy for the anon role. If you still have the
# variable set in Vercel, delete it.

# -----------------------------------------------------------------------------
# 2. META / FACEBOOK GRAPH API  (developers.facebook.com -> your App)
# -----------------------------------------------------------------------------
# A random string YOU invent. You paste the same value into the Meta webhook
# setup screen; Meta echoes it back on the GET verification request.
META_VERIFY_TOKEN=your-random-verify-token

# App Secret: App Settings -> Basic -> App Secret. Used to verify the
# X-Hub-Signature-256 header on every incoming webhook POST.
META_APP_SECRET=your-meta-app-secret

# Page Access Token (Messenger) with pages_messaging + pages_manage_metadata
META_PAGE_ACCESS_TOKEN=your-page-access-token

# Instagram Business Account token (only if you reply to IG DMs separately;
# if your IG is linked to the Page, the Page token above usually works)
META_IG_ACCESS_TOKEN=your-instagram-access-token

# Page/IG numeric IDs, used to ignore echoes of your own outgoing messages
META_PAGE_ID=your-facebook-page-id
META_IG_ID=your-instagram-business-account-id

# Graph API version to pin. Bump this when Meta deprecates a version.
META_GRAPH_API_VERSION=v23.0

# -----------------------------------------------------------------------------
# 3. GOOGLE GEMINI  (aistudio.google.com -> Get API key)
# -----------------------------------------------------------------------------
# NOTE: @ai-sdk/google reads GOOGLE_GENERATIVE_AI_API_KEY automatically.
# GEMINI_API_KEY is an alias supported by the agent code as a fallback.
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key
GEMINI_API_KEY=your-google-ai-studio-key


# Model used by both agents (Agent 1 chat / Agent 2 order tool extraction).
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# 4. TELEGRAM ORDER NOTIFICATIONS  (chat with @BotFather)
# -----------------------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Your personal/team chat id. Send a message to your bot then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find it.
TELEGRAM_CHAT_ID=your-telegram-chat-id

# -----------------------------------------------------------------------------
# 5. BUSINESSKORO DROPSHIPPING SUPPLIER API
# -----------------------------------------------------------------------------
# Optional. The code defaults to https://api.businesskoro.com/api/v1/storefront,
# so only set this to point at a sandbox.
SUPPLIER_API_BASE_URL=https://api.businesskoro.com/api/v1/storefront

# Sent as the `x-api-key` header (BusinessKoro does not use a Bearer token).
SUPPLIER_API_KEY=your-businesskoro-api-key

# NOTE: the productId of the 5 in 1 Gaming Combo is not an env var — it is the
# BUSINESSKORO_PRODUCT_ID constant at the top of src/lib/supplier.ts. Replace the
# placeholder there with the id from your BusinessKoro dashboard.

# -----------------------------------------------------------------------------
# 6. APP / SECURITY
# -----------------------------------------------------------------------------
# Public URL of this deployment. Meta requires a public HTTPS URL.
# Local dev: use an ngrok tunnel, e.g. https://abcd-1234.ngrok-free.app
NEXT_PUBLIC_APP_URL=https://tsf-oder.mlwio.com

# Dashboard password, used for two things:
#   1. Signing in at /login. The dashboard is a single-operator tool, so there
#      is one shared password; it is exchanged for an httpOnly session cookie.
#   2. The `x-admin-key` header on the scripted /api/messages/send endpoint.
# Pick something long and random (e.g. `openssl rand -base64 32`).
# Leave it empty and the dashboard locks itself out rather than opening up.
ADMIN_API_KEY=your-dashboard-password